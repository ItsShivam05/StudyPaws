# Study Paws — environment variables
# Copy to .env.local and fill in values from your Supabase project:
#   Dashboard → Project Settings → API (or "API Keys")
#
# Both values are PUBLIC by design: the browser uses them, and Row Level
# Security in supabase/migrations protects the data. Never put the
# service_role / secret key in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New-style publishable key (sb_publishable_...) …
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# … or the legacy anon key (either one works)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
